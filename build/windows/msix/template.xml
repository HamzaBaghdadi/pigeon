<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="pigeon.exe"
        Arguments=""
        InstallLocation="C:\Program Files\Pigeon\Pigeon">
    </Installer>
    <PackageInformation
        PackageName="Pigeon"
        PackageDisplayName="Pigeon"
        PublisherName="CN=Pigeon"
        PublisherDisplayName="Pigeon"
        Version="0.2.0.0"
        PackageDescription="A secure, open-source email client">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="io.github.hamzabaghdadi.pigeon"
                Description="A secure, open-source email client"
                DisplayName="Pigeon"
                ExecutableName="pigeon.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Pigeon</DisplayName>
            <PublisherDisplayName>Pigeon</PublisherDisplayName>
            <Description>A secure, open-source email client</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="pigeon.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
